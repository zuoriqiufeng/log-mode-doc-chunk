# ============================================================
# chunk 配置模板 — 复制为 .env 后按需修改
#   cp .env.example .env
# 注意: .env 内含真实密钥，已在 .gitignore 中排除，切勿提交
# 优先级: CLI 参数 > .env 环境变量 > 代码内硬编码默认值
# ============================================================

# ---- 嵌入后端 ----
# openai: 调用 OpenAI 嵌入 API；local: 本地 sentence-transformers 模型
EMBEDDING_BACKEND=local
# openai 可选: text-embedding-3-small | text-embedding-3-large | text-embedding-ada-002
# local  可选: BAAI/bge-large-zh-v1.5 | all-MiniLM-L6-v2 | sentence-transformers/all-mpnet-base-v2
EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5
# 批处理大小（openai 默认 100，local 默认 32）
EMBEDDING_BATCH_SIZE=100

# ---- OpenAI 后端 ----
OPENAI_API_KEY=sk-your-openai-api-key
# Contextual RAG 的 --use-llm 模式使用的生成模型
OPENAI_MODEL=gpt-4o-mini

# ---- 本地嵌入后端 ----
# HuggingFace 镜像（国内无法直连 huggingface.co 时使用）
HF_ENDPOINT=https://hf-mirror.com
# 模型缓存目录，建议指向项目内 HuggingFace/（已在 .gitignore 排除）
# 服务方式运行时建议写绝对路径，相对路径按进程 cwd 解析
HF_HOME=/absolute/path/to/chunk/HuggingFace
# cpu | cuda | cuda:0
LOCAL_EMBEDDING_DEVICE=cpu
# 是否对输出做 L2 归一化
LOCAL_EMBEDDING_NORMALIZE=false

# ---- 分块参数 ----
CHUNK_SIZE=512
MINI_CHUNK_SIZE=150
ENABLE_LARGE_CHUNKS=true
LARGE_CHUNK_RATIO=4

# ---- 增强阶段开关 ----
ENABLE_CONTEXTUAL_RAG=false
USE_LLM=false
ENABLE_ENRICHMENT=true

# ---- 图片处理（本地 OCR / 远程 Vision 双后端） ----
ENABLE_IMAGE_PROCESSING=true
# local: EasyOCR（需 pip install -r requirements-image.txt）；remote: OpenAI Vision 兼容接口
IMAGE_PROCESSOR_BACKEND=remote
IMAGE_PROCESSOR_MODEL=mimo-v2.5
# 留空则回退到 OPENAI_API_KEY
IMAGE_PROCESSOR_API_KEY=
# 留空使用 OpenAI 官方地址；可填任意 OpenAI 兼容服务（vLLM / Ollama 等）
IMAGE_PROCESSOR_BASE_URL=https://api.xiaomimimo.com/v1
# 本地 OCR 语言，逗号分隔
OCR_LANGUAGES=ch_sim,en
# cpu | cuda
OCR_DEVICE=cpu
# 图片处理结果缓存目录
IMAGE_CACHE_DIR=.image_cache
# 小于该尺寸的图片跳过处理（像素）
IMAGE_MIN_WIDTH=10
IMAGE_MIN_HEIGHT=10

# ---- 日志模式库 ----
# 日志模式独立 collection，不得与文档 collection 混用
LOG_PATTERN_COLLECTION_NAME=log_patterns_collection

# ---- 并发度（文件级 × 单文件内图片级） ----
FILE_CONCURRENCY=3
IMAGE_CONCURRENCY=6
